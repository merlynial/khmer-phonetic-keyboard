<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.249.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="https://merlynial.github.io/khmer-phonetic-keyboard/">Khmer Phonetic</Name>
    <Copyright URL="">© Keang Pakrinha</Copyright>
    <Author URL="">Keang Pakrinha</Author>
    <Description URL="">Type Khmer by sound: suastei becomes សួស្តី. Includes a 20,000 word dictionary for predictions.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\khmer_phonetic.kmx</Name>
    </File>
    <File>
      <Name>..\build\khmer_phonetic.js</Name>
    </File>
    <File>
      <Name>..\build\khmer_phonetic.kvk</Name>
    </File>
    <File>
      <Name>Siemreap-Regular.ttf</Name>
    </File>
    <File>
      <Name>welcome.htm</Name>
    </File>
    <File>
      <Name>readme.htm</Name>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
    </File>
  </Files>
  <Keyboards>
    <Keyboard>
      <Name>Khmer Phonetic</Name>
      <ID>khmer_phonetic</ID>
      <OSKFont>Siemreap-Regular.ttf</OSKFont>
      <DisplayFont>Siemreap-Regular.ttf</DisplayFont>
      <Languages>
        <Language ID="km">Khmer</Language>
      </Languages>
    </Keyboard>
  </Keyboards>
  <LexicalModels/>
  <RelatedPackages>
    <RelatedPackage ID="pakrinha.km.khmerphonetic" Relationship="related"/>
  </RelatedPackages>
</Package>
