      <Name>Khmer Phonetic</Name>
      <ID>khmer_phonetic</ID>
      <OSKFont>Siemreap-Regular.ttf</OSKFont>
      <DisplayFont>Siemreap-Regular.ttf</DisplayFont>
      <Languages>
